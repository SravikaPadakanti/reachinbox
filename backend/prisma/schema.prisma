generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon: unpooled connection, used only for migrations
}

enum EmailStatus {
  PENDING     // created, not yet handed to BullMQ (rare, transitional)
  SCHEDULED   // job exists in BullMQ with a delay, waiting to fire
  SENT
  FAILED
  RESCHEDULED // pushed to next hour window because rate limit was hit
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

// One "Compose New Email" submission = one campaign, fanned out into many EmailJob rows (one per recipient)
model Campaign {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  fromSender          String
  subject             String
  body                String   @db.Text
  delayBetweenEmailsMs Int     @default(2000)
  hourlyLimit         Int     @default(100)
  startTime           DateTime
  attachments         Json?
  createdAt           DateTime @default(now())

  jobs EmailJob[]
}

model EmailJob {
  id          String      @id @default(uuid())
  campaignId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  recipient   String
  subject     String
  body        String      @db.Text
  fromSender  String

  status      EmailStatus @default(SCHEDULED)
  scheduledAt DateTime    // the time we intend/intended to send at (updates if rescheduled)
  sentAt      DateTime?
  failReason  String?
  previewUrl  String?
  attachments Json?

  // BullMQ job id for this row — lets us look up / avoid re-adding the same job (idempotency)
  bullJobId   String?     @unique

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([fromSender])
}
