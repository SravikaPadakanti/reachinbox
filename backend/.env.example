# --- Server ---
PORT=4000
SESSION_SECRET=change_this_to_a_random_string
FRONTEND_URL=http://localhost:3000

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL="postgresql://reachinbox:reachinbox_pass@localhost:5432/reachinbox"

# --- Redis (matches docker-compose.yml) ---
REDIS_URL="redis://localhost:6379"

# --- Ethereal Email (get real values from https://ethereal.email) ---
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_user@ethereal.email
ETHEREAL_PASS=your_ethereal_password

# --- Google OAuth (get real values from Google Cloud Console) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Rate limiting / concurrency (must be configurable, not hardcoded) ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
