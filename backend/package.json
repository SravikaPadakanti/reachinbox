{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "Email job scheduler backend - BullMQ + Redis + Postgres + Ethereal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:worker\"",
    "dev:server": "nodemon --exec ts-node src/index.ts",
    "dev:worker": "nodemon --exec ts-node src/workers/emailWorker.ts",
    "build": "prisma generate && prisma db push --accept-data-loss && tsc",
    "start": "concurrently \"node dist/index.js\" \"node dist/workers/emailWorker.js\"",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/workers/emailWorker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "node test-all-suites.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "bullmq": "^5.13.2",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
